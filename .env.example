# Copy to .env and fill locally. Never commit .env.
# Grok Bot: export these on the Bot computer. Do not paste keys into chat.

# Required for the email path
INSTANTLY_API_KEY=

# Required for the LinkedIn path
HEYREACH_API_KEY=

# List / enrich — only the sources you use
PROSPEO_API_KEY=
LEADMAGIC_API_KEY=
OCEAN_API_TOKEN=

# ZoomInfo GTM CLI (@zoominfo/gtm-ai-cli): no env key.
# Run: gtm auth login   then   gtm auth whoami
# Token is stored in ~/.config/gtm-ai/

# Clay (clay-gtm-cli): register tables with clay tables add --webhook-url ...
# Optional stable callback instead of cloudflared:
# CLAY_CALLBACK_URL=

# Meetings (use the one in company.md)
CALENDLY_TOKEN=
CAL_API_KEY=
# topcal: device auth — topcal auth register / topcal auth status --json

# CRM / tasks / mail (only what company.md names)
# HUBSPOT_ACCESS_TOKEN=
# SALESFORCE_ACCESS_TOKEN=
# SALESFORCE_INSTANCE_URL=
# ATTIO_API_KEY=
# PIPEDRIVE_API_TOKEN=
# AIRTABLE_TOKEN=
# CLICKUP_API_TOKEN=
# M365_CLIENT_ID=
# M365_TENANT_ID=
